# Governance OneLens — client env vars (Vite)
#
# Copy to .env.local (gitignored) for local dev, or set as real environment
# variables in your deployment pipeline. Never commit real values — this file
# only documents the shape.
#
# Production builds fail closed when required values are absent. Local Vite
# development defaults only the Rayfin API URL to http://localhost:5168.
# `rayfin up` regenerates .env.local. Deployment source values, including the
# server-only governance-reader allowlist, belong in ignored rayfin/.env as
# documented in README.md.

# --- Rayfin backend (auto-generated by `rayfin env --framework vite`) ---
VITE_RAYFIN_API_URL=
VITE_RAYFIN_PUBLISHABLE_KEY=

# --- Fabric SSO / app identity (auto-generated by `rayfin env --framework vite`) ---
VITE_FABRIC_WORKSPACE_ID=
VITE_FABRIC_ITEM_ID=
VITE_FABRIC_PORTAL_URL=

# --- Ask OneLens ---
# Entra tenant id.
VITE_FABRIC_TENANT_ID=
# Client id of the dedicated SPA app registration used for the delegated
# Fabric-scoped MSAL popup (separate from Rayfin's own Fabric SSO broker).
VITE_RAYFIN_FABRIC_SPA_CLIENT_ID=
# Fabric workspace id containing the "Ask OneLens" Data Agent (may be the same
# as VITE_FABRIC_WORKSPACE_ID above, or a separate analysis workspace).
VITE_RAYFIN_ASKONELENS_WORKSPACE_ID=
# If omitted, the client reuses VITE_FABRIC_WORKSPACE_ID for single-workspace installs.
# Fabric Data Agent item id for "Ask OneLens".
VITE_RAYFIN_ASKONELENS_AGENT_ID=

# `rayfin up` regenerates .env.local. Persist these three custom browser values
# in ignored rayfin/.env as RAYFIN_PUBLIC_FABRIC_SPA_CLIENT_ID,
# RAYFIN_PUBLIC_ASKONELENS_WORKSPACE_ID, and RAYFIN_PUBLIC_ASKONELENS_AGENT_ID.
