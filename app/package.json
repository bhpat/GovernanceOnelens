{
  "name": "governance-onelens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "template": {
    "name": "governance-onelens",
    "displayName": "Governance OneLens",
    "description": "Fabric-native governance catalog and observability app — auto-discovers workspaces, items, domains, lineage and sensitivity across the tenant via the Fabric admin + Power BI scanner APIs, and surfaces posture, coverage, and lineage in a Rayfin-hosted UI"
  },
  "scripts": {
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "dev": "rayfin up --exclude-services staticHosting && vite",
    "build": "tsc -b && vite build",
    "build:fabric": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "rayfin:db": "rayfin up db apply",
    "mcp": "raymcp start"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.17.0",
    "@dagrejs/dagre": "^3.0.0",
    "@fluentui/react-components": "^9.74.3",
    "@fluentui/react-icons": "^2.0.332",
    "@microsoft/rayfin-auth-provider-fabric": "^1.33.2",
    "@microsoft/rayfin-client": "^1.33.2",
    "@microsoft/rayfin-core": "^1.33.2",
    "@microsoft/rayfin-data": "^1.33.2",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/vite": "^4.1.11",
    "@tremor/react": "^3.18.7",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.3.0-canary-fef12a01-20260413",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "tremor": "^0.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/rayfin-cli": "^1.33.2",
    "@microsoft/rayfin-mcp": "^1.33.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^24.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
