# Python
.venv/
__pycache__/
*.pyc

# Node / build (defensive; app/.gitignore also covers these)
node_modules/
**/node_modules/
dist/
**/dist/

# Rayfin / secrets — never commit env files, publishable keys, or deploy records
**/.env
**/.env.*
!**/.env.example
**/rayfin/.env*
**/rayfin/.deployments.json
**/.rayfin/

# Local extraction / temp artifacts
_pdf_extract.txt
*.tmp

# OS
.DS_Store
Thumbs.db

.vite/

