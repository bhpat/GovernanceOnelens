# Governance OneLens scanner and analysis deployment configuration.
#
# This is documentation only. Do not commit a populated .env file. On Windows,
# set values in PowerShell with: $env:NAME = "value"

# Primary workspace containing the Rayfin app and Spark Job Definition.
ONELENS_WORKSPACE_ID=
ONELENS_SJD_ID=

# Workspace containing the semantic model and Ask OneLens Data Agent. Set this
# equal to ONELENS_WORKSPACE_ID for a single-workspace deployment.
ONELENS_ANALYSIS_WORKSPACE_ID=
ONELENS_SEMANTIC_MODEL_ID=
ONELENS_DATA_AGENT_ID=

# Fabric SQL database used by the scanner, views, semantic model, and connector
# self-registration. These are identifiers, not credentials.
ONELENS_SQL_SERVER=
ONELENS_SQL_DB=

# Local deploy/validation polling limits in seconds.
ONELENS_JOB_TIMEOUT_SECONDS=900
ONELENS_LRO_TIMEOUT_SECONDS=900

# Internal/test-only override for the generated runtime JSON path. Normal local
# and Fabric deployments should leave this empty.
ONELENS_RUNTIME_CONFIG_FILE=

# Non-secret metadata written to the Fabric connector status row.
ONELENS_PORTAL=app.fabric.microsoft.com
ONELENS_WORKSPACE_NAME=OneLens-Workspace
ONELENS_LAKEHOUSE_NAME=onelens_scan_lh
ONELENS_SPARKJOB_NAME=governance-onelens-scan
ONELENS_CAPACITY_NAME=Fabric capacity
ONELENS_AGENT_NAME=Ask OneLens

# Optional JSON map from sensitivity label GUID to display name.
# Example: {"00000000-0000-0000-0000-000000000000":"Confidential"}
ONELENS_LABEL_MAP=

# Local development scanner only. Leave all three empty to use the current
# Azure CLI identity. Production SJD runs use Fabric's secretless token library;
# deploy_sjd.py never uploads these values.
ONELENS_TENANT_ID=
ONELENS_SCAN_CLIENT_ID=
ONELENS_SCAN_SECRET=